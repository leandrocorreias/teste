# ---- Instfy Intelligence Studio ----
# Postgres is canonical (what the hosted deployment runs).
# For a local file database instead: npm run db:push:sqlite, and set
# DATABASE_URL="file:./dev.db"
DATABASE_URL="postgresql://user:password@host:5432/postgres?sslmode=require"

# AI provider. Leave BOTH empty to run in explicitly-labelled DEMO MODE.
# Demo mode generates deterministic placeholder narrative and never claims research.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL="claude-sonnet-4-5"

# Optional: only set when a REAL web-research connector is wired.
# When unset, the Research stage is skipped and documents state that no external research was performed.
RESEARCH_CONNECTOR=""

# Artifact storage (PDF/PPTX). Must stay outside /public.
ARTIFACT_DIR="./storage/artifacts"

# How PDFs are produced.
#   server  — Chromium (Playwright) prints server-side and stores the artifact.
#             Needs a writable disk and a Chromium binary.
#   browser — the viewer's browser prints the same /print route. No disk, no
#             Chromium. Used automatically on Vercel.
# Unset: 'browser' when VERCEL is set, otherwise 'server'.
PDF_ENGINE=""

# Chromium used by Playwright when PDF_ENGINE=server.
PLAYWRIGHT_BROWSERS_PATH="/opt/pw-browsers"
CHROMIUM_EXECUTABLE_PATH=""

# Commercial policy
DISCOUNT_AUTHORIZATION_CAP_PCT="0"
DEFAULT_TAX_RATE_PCT=""
APP_BASE_URL="http://localhost:3100"

# Required to enable POST /api/admin/bootstrap, which seeds a hosted database
# once. Leave empty to keep the route disabled.
BOOTSTRAP_SECRET=""
