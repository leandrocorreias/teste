# ---- Instfy Intelligence Studio ----
DATABASE_URL="file:./dev.db"

# AI provider. Leave BOTH empty to run in explicitly-labelled DEMO MODE.
# Demo mode generates deterministic placeholder narrative and never claims research.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL="claude-sonnet-4-5"

# Optional: only set when a REAL web-research connector is wired.
# When unset, the Research stage is skipped and documents state that no external research was performed.
RESEARCH_CONNECTOR=""

# Artifact storage (PDF/PPTX). Must stay outside /public.
ARTIFACT_DIR="./storage/artifacts"

# Chromium used by Playwright for HTML -> PDF rendering.
PLAYWRIGHT_BROWSERS_PATH="/opt/pw-browsers"
CHROMIUM_EXECUTABLE_PATH=""

# Commercial policy
DISCOUNT_AUTHORIZATION_CAP_PCT="0"
DEFAULT_TAX_RATE_PCT=""
APP_BASE_URL="http://localhost:3100"
